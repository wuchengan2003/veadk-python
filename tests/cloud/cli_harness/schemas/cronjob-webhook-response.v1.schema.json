{
  "$defs": {
    "ResponseError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ResponseError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1",
      "title": "Schemaversion",
      "type": "string"
    },
    "eventID": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Eventid"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseError"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "eventID",
    "accepted",
    "error"
  ],
  "title": "WebhookResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "eventID": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "#/$defs/ResponseError"
          }
        }
      }
    }
  ]
}
